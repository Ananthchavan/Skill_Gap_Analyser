# Server
PORT=8080
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/your-db-name

# Session — required at startup, no fallback; use a long random string
SESSION_SECRET=replace_with_a_long_random_secret

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:8080/auth/github/callback

# GitHub Personal Access Token (for repo analysis)
GITHUB_PAT=your_github_pat

# AI providers
GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_key
GROQ_API_KEY=your_groq_api_key
# Optional: override the default Groq model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Redis (BullMQ queue)
REDIS_URL=redis://localhost:6379

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173

